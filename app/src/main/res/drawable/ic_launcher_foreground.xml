<!--
  The approved mascot is supplied as a high-resolution transparent bitmap. Its visible
  bounds occupy roughly four fifths of the source canvas, so a 76dp layer keeps the flower
  inside the adaptive icon's central safe zone while preserving its intentional padding.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="76dp"
        android:height="76dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/kimi_launcher_foreground"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
